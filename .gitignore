node_modules/
.netlify/

# Environment variables and secrets
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env.*.local

# Keep the public, secret-free template versioned
!.env.example

# Secure environment packs. Only *.example and documentation may be committed.
/env/*.env
/env/*.local
/env/*.secret
/env/tokens/

*.log
coverage/
.DS_Store

# Build output is generated into /public at build time
# (npm run build:web), not committed, same as any other dist/.
# Anchored to the repo root so it doesn't also match web/public/,
# which holds real source assets (manifest, icons, service worker).
/public/
web/test-results/
web/playwright-report/
